# OfferSignal uses no remote services and requires no environment variables.
# Optional for scripts/smoke.sh:
OFFERSIGNAL_SMOKE_PORT=4174

# Optional TypeScript/Node SQLite result service
OFFERSIGNAL_DB_PATH=./backend/offersignal.sqlite
OFFERSIGNAL_CORS_ORIGIN=http://localhost:8080
OFFERSIGNAL_RATE_LIMIT=60
# Saved summaries expire after 30 days by default; allowed range is 5 minutes to 365 days.
OFFERSIGNAL_RETENTION_SECONDS=2592000
